# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SIF Integration
# Base URL for the SIF RPC endpoint (e.g. https://customer.public360online.com)
SIF_BASE_URL=https://your-instance.public360online.com
# Path to the SIF RPC endpoint (typically /rpc/v2)
SIF_RPC_PATH=/rpc/v2

# Authentication mode: "authkey" | "combined_daemon"
SIF_AUTH_MODE=authkey

# AuthKey authentication (SIF_AUTH_MODE=authkey)
SIF_AUTHKEY=your-authkey-guid-here

# Combined daemon authentication (SIF_AUTH_MODE=combined_daemon)
# In combined_daemon mode: app fetches bearer token via client_credentials, then sends both
SIF_CLIENT_ID=your-client-id
SIF_BEARER_TOKEN_URL=https://login.microsoftonline.com/your-tenant-id/oauth2/v2.0/token
SIF_CLIENT_SECRET=your-client-secret
SIF_CLIENT_ID_OAUTH=your-oauth-client-id
SIF_SCOPE=api://your-scope/.default

# Timeout in milliseconds (default: 30000)
SIF_TIMEOUT_MS=30000
